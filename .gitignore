__pycache__/
*.pyc
.pytest_cache/

# Reports from local contacts. Never committed: site_profile.py reads them
# from $RO_LOCAL_KNOWLEDGE (default ~/.renewable-opposition/local_knowledge.csv),
# and the precommit "private" gate refuses any staged local_knowledge* file.
data/review/local_knowledge.csv
local_knowledge*

# The national database file (scripts/build_database.py), rebuilt from
# data/processed/ on demand and never committed. Its Parquet export and the
# summaries in data/db/ are committed by the Build dashboard data workflow.
data/db/*.duckdb
data/db/*.duckdb.wal
data/db/tmp*/

# Git worktrees that Claude Code sessions create for parallel agents.
.claude/worktrees/

# Packets the research agents pass between them (docs/AGENTS.md). Per run,
# never committed: the pull request description carries what a reader needs.
.packets/

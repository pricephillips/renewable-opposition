{"state_code":"MS",
"policies":[
{"id":"MS-local_preemption-1","technology":"solar","policy_type":"local_preemption","who_decides":"local_government","state_body":null,"threshold_mw":null,"summary":"Since July 1, 2026, counties and cities may still zone solar power facilities of 5 MW AC or more under their Title 17 powers, but they may not impose removal or restoration duties, or require financial assurance for them, beyond requiring proof that the facility complies with the state's decommissioning terms. Those state terms require leases signed on or after that date to oblige the developer to remove the facility, restore the land and post rising financial assurance (5 percent of net decommissioning cost at commercial operation, 50 percent at year 10, all of it at year 15).","statute_citation":"2026 Miss. Laws ch. 420 (SB 2527), sec. 1(1)(e), (2), (3), (4), (9) (codified section number not seen)","statute_url":"https://billstatus.ls.state.ms.us/documents/2026/pdf/SB/2500-2599/SB2527SG.pdf","evidence_level":"primary_source","verification":"verified","reviewed_on":"2026-10-09"},
{"id":"MS-siting_authority-1","technology":"solar;wind","policy_type":"siting_authority","who_decides":"hybrid","state_body":"Mississippi Public Service Commission","threshold_mw":null,"summary":"No person may build or operate electric generating equipment for sale to or for the public, and no utility or other person may begin building a generating facility whose power will directly or indirectly furnish public utility service, without a certificate of public convenience and necessity from the Public Service Commission; generators built mainly for the owner's own use are exempt. Counties and cities also regulate wind and solar facilities through their Title 17 zoning powers over buildings, structures and land use.","statute_citation":"Miss. Code Ann. sections 77-3-11(2), 77-3-14(1), (6), (7); 77-3-3(d)(i); 17-1-7(1); 2026 Miss. Laws ch. 420 (SB 2527), s1(4)","statute_url":"https://billstatus.ls.state.ms.us/documents/20242E/pdf/SB/2001-2099/SB2001SG.pdf","evidence_level":"primary_source","verification":"verified","reviewed_on":"2026-10-09"}
],

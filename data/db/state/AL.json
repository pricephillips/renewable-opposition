"policies":[
{"id":"AL-other-1","technology":"wind","policy_type":"other","who_decides":"local_government","state_body":null,"threshold_mw":null,"summary":"Statewide, a wind energy facility may not encroach on or adversely affect military operations and readiness, and a local government may not approve one until the developer shows a Department of Defense Siting Clearinghouse finding of no presumed risk, a mitigation agreement, or an FAA determination of no hazard (or the approval is conditioned on one); notice to the Clearinghouse is due at least 270 days before construction.","statute_citation":"Ala. Code 11-106-6(a),(e)-(i), 11-106-3(8), 11-106-4(b)","statute_url":"https://alison.legislature.state.al.us/code-of-alabama?section=11-106-6","evidence_level":"primary_source","verification":"verified","reviewed_on":"2026-10-09"},
{"id":"AL-other-2","technology":"wind","policy_type":"other","who_decides":"local_government","state_body":null,"threshold_mw":null,"summary":"In Cherokee, DeKalb and Etowah counties only (local acts, not a statewide rule), a wind energy system built to sell its power needs a permit from the county commission or town council, must sit at least 2,500 feet from the nearest edge of any adjacent property, may make no more than 40 decibels of noise at its own property line, and must be set back 1.5 times tower height from overhead power lines. The owner must also post financial assurance for removal and $1,000,000 for damage to adjoining property.","statute_citation":"Ala. Code 45-10-260.02, 45-10-260.04, 45-10-260.05(i)-(k) (Cherokee County); 45-25-260.02, 45-25-260.04, 45-25-260.05(i)-(k) (DeKalb County); 45-28-260.02, 45-28-260.04, 45-28-260.05(i)-(k) (Etowah County)","statute_url":"https://alison.legislature.state.al.us/code-of-alabama?section=45-10-260.05","evidence_level":"primary_source","verification":"verified","reviewed_on":"2026-10-09"},
{"id":"AL-siting_authority-1","technology":"solar;wind","policy_type":"siting_authority","who_decides":"local_government","state_body":null,"threshold_mw":null,"summary":"No state body sites wind or solar in Alabama; local governments decide. Local acts give Baldwin County zoning power over wind facilities and require a local permit for any commercial wind system in Cherokee, DeKalb and Etowah counties; a utility building a plant also needs a certificate of convenience and necessity from the Public Service Commission.","statute_citation":"Ala. Code 45-2-262 (Baldwin), 45-10-260.02 (Cherokee), 45-25-260.02 (DeKalb), 45-28-260.02 (Etowah); 37-4-28","statute_url":"https://alison.legislature.state.al.us/code-of-alabama?section=45-10-260.02","evidence_level":"primary_source","verification":"verified","reviewed_on":"2026-10-09"}
],
